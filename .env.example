# Copiare in .env (impianto reale) o .env.sim (simulatore)
TZ=Europe/Rome
LOG_LEVEL=INFO
# soliscloud | sim
FONTE_SOLARE=soliscloud
# catena di fallback, in ordine: maxa_cloud | maxa_cloud,rele | rele | sim
# maxa_cloud per ora legge soltanto: i comandi passano al relè quando c'è (aggiungere ,rele dopo il cablaggio)
POMPA=maxa_cloud
# openwebnet | sim | nessuno
SENSORI_TEMP=openwebnet
OWN_HOST=192.168.5.DA_COMPILARE
OWN_PORT=20000
