# Copiare in .env (impianto reale) o .env.sim (simulatore)
TZ=Europe/Rome
LOG_LEVEL=INFO
# soliscloud | sim
FONTE_SOLARE=soliscloud
# catena di fallback, in ordine: maxa_web,rele | rele | sim
POMPA=maxa_web,rele
# openwebnet | sim | nessuno
SENSORI_TEMP=openwebnet
OWN_HOST=192.168.5.DA_COMPILARE
OWN_PORT=20000
